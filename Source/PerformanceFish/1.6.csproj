<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutDir>..\..\1.6\Assemblies\</OutDir>
		<Copyright>Copyright (c) 2024 Bradson</Copyright>
	</PropertyGroup>
	<PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
		<DefineConstants>DEBUG;V1_6</DefineConstants>
	</PropertyGroup>
	<PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
		<DefineConstants>V1_6</DefineConstants>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.*" />
		<!-- 2.4.* matches the Harmony that Prepatcher ships for 1.6. -->
		<PackageReference Include="Lib.Harmony" Version="2.4.*" ExcludeAssets="runtime" />
		<!-- NOTE: upstream points at a sibling folder named "Fishery". Chris's copy is
		     "Fishery-main", so this HintPath is adjusted to match the actual layout.
		     Build Fishery's 1.6.csproj FIRST so this file exists. -->
		<Reference Include="1Fishery">
			<HintPath>..\..\..\Fishery-main\1.6\Assemblies\1Fishery.dll</HintPath>
			<Private>False</Private>
		</Reference>
	</ItemGroup>

	<!--
		Everything below is carried over from getting Fishery to build. Same root causes,
		applied up front so we do not rediscover them one round at a time.
	-->

	<PropertyGroup>
		<!--
			Drops the IgnoresAccessChecksTo strategy. It emits an assembly-wide attribute that
			makes Roslyn ignore accessibility for ALL of 0Harmony, which drags Harmony's
			internal System.Span<T> into scope where it collides with the Span<T> that
			RimWorld 1.6's newer mscorlib now provides. RimWorld is Mono, and the Unsafe
			strategy covers Mono, so nothing is lost.
		-->
		<PublicizerRuntimeStrategies>Unsafe</PublicizerRuntimeStrategies>
	</PropertyGroup>

	<ItemGroup>
		<!--
			Replace the blanket 0Harmony publicize with a targeted one. Performance Fish uses
			Mono.Cecil in 91 places and MonoMod in 8, so those namespaces are required.
			System.Span<T> does not match the pattern and stays internal.
		-->
		<Publicize Remove="0Harmony" />
		<Publicize Include="0Harmony" MemberPattern="^(Mono\.|MonoMod\.|HarmonyLib\.)" IncludeVirtualMembers="false" />

		<!--
			Corrected modern-BCL names, verified against krafs.rimworld.ref 1.6.4871.
			Directory.Build.props uses the .NET Framework spellings, which now no-op.
			Performance Fish does not currently touch these, but they cost nothing and stop
			a confusing failure later if a patch does reach for them.
		-->
		<Publicize Include="mscorlib:System.Collections.Generic.Dictionary`2._buckets" />
		<Publicize Include="mscorlib:System.Collections.Generic.Dictionary`2._entries" />
		<Publicize Include="mscorlib:System.Collections.Generic.Dictionary`2._version" />
		<Publicize Include="mscorlib:System.String._firstChar" />
		<Publicize Include="mscorlib:System.Array.UnsafeLoad" />
		<Publicize Include="mscorlib:System.Array.UnsafeStore" />
		<Publicize Include="mscorlib:System.Array.UnsafeMov" />

		<!--
			Mono renamed System.Reflection.MonoField to RuntimeFieldInfo in the newer BCL.
			Directory.Build.props publicizes the old name, which now matches nothing.
		-->
		<Publicize Include="mscorlib:System.Reflection.RuntimeFieldInfo" />
		<Publicize Include="mscorlib:System.Reflection.RtFieldInfo" />
	</ItemGroup>

	<ItemGroup>
		<!--
			Silences MSB3277. Directory.Build.props asks for 6.0.*, which resolved to 6.0.0
			here, while Fishery's 1.6 build resolved 6.0.3 and ships that DLL in its
			Assemblies folder. Two different versions of the same assembly at runtime is a
			MissingMethodException waiting to happen, since only one gets loaded. Pinning
			both sides to 6.0.3 removes the mismatch.
		-->
		<!--
			Must match Fishery's floating range exactly. Fishery's Directory.Build.Props uses
			"6.*"; Performance Fish's uses "6.0.*", so the two resolved different packages and
			ended up referencing different ASSEMBLY versions - 6.0.3.0 vs 6.0.1.0.

			That matters because this assembly is strong-named, so the CLR enforces version
			binding, and Performance Fish sets ExcludeAssets="runtime" - it ships no copy of
			its own and loads the 6.0.3.0 that Fishery ships. Asking for 6.0.1.0 and finding
			only 6.0.3.0 is a load failure at startup, not a subtle bug.

			Do not pin an explicit number here: 6.0.3 is an ASSEMBLY version, not a package
			version, and asking for it makes NuGet fall forward to 6.1.0 and reintroduce the
			mismatch. Matching the range is what keeps them in step.
		-->
		<PackageReference Update="System.Runtime.CompilerServices.Unsafe" Version="6.*" />
	</ItemGroup>
</Project>
